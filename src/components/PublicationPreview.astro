---
import type { CollectionEntry } from 'astro:content';

interface Props {
	publication: CollectionEntry<'publications'> | CollectionEntry<'publicationsDe'>;
}

const { data } = Astro.props.publication;
const isGerman = Astro.url.pathname === '/de/' || Astro.url.pathname.startsWith('/de/');
const dateLabel = data.publishDate.toLocaleDateString(isGerman ? 'de-DE' : 'en-US', {
	year: 'numeric',
	month: 'short',
});
const manuscriptLabel = isGerman ? 'Manuskript herunterladen' : 'Download Manuscript';
const journalLabel = isGerman ? 'Journal-Link' : 'Journal Link';
const accepted = /accepted|akzeptiert/i.test(data.venue);
const celebrationLabel = isGerman ? 'Erfolgsmeldung' : 'Celebration';
---

<article class="card">
	<div class="copy">
		<p class="meta">
			{dateLabel} · {data.venue}
			{accepted && (
				<span class="celebration" aria-label={celebrationLabel} title={celebrationLabel}>
					🎉
				</span>
			)}
		</p>
		<h3>{data.title}</h3>
		<p class="description">{data.description}</p>
		<p class="abstract">{data.abstractSummary}</p>
		<p class="authors">
			<span class="first-author">
				{data.authors[0]}<span class="star" aria-hidden="true">*</span>
			</span>
			{data.authors.slice(1).length > 0 && <span>, {data.authors.slice(1).join(', ')}</span>}
		</p>
		{data.authorRole && (
			<p class="role">
				<span class="star" aria-hidden="true">*</span> {data.authorRole}
			</p>
		)}
		<div class="actions">
			<a href={data.downloadHref} download class="download-link">{manuscriptLabel}</a>
			<a href={data.journalHref} target="_blank" rel="noopener noreferrer" class="journal-link">
				{journalLabel}
			</a>
		</div>
	</div>
</article>

<style>
	.card {
		display: flex;
		min-height: 16rem;
		background:
			linear-gradient(145deg, rgba(15, 135, 122, 0.2), transparent 60%),
			var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		box-shadow: var(--shadow-sm);
	}

	.copy {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		width: 100%;
		padding: 1.25rem;
	}

	.meta {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--gray-400);
	}

	h3 {
		font-size: var(--text-xl);
		color: var(--gray-100);
	}

	.description {
		color: var(--gray-200);
	}

	.abstract {
		color: var(--gray-300);
	}

	.authors {
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	.first-author {
		color: var(--gray-400);
		white-space: nowrap;
	}

	.star {
		color: #2dbf7d;
		font-size: 0.9em;
		font-weight: 700;
		vertical-align: super;
		margin-left: 0.08em;
	}

	.role {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		width: fit-content;
		padding: 0.25rem 0.6rem;
		border-radius: 999rem;
		border: 1px solid rgba(63, 220, 170, 0.45);
		background: rgba(34, 164, 125, 0.18);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--gray-100);
	}

	.celebration {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-inline-start: 0.4rem;
		font-size: 1rem;
		line-height: 1;
		animation: pop-cheer 2.1s ease-in-out infinite;
		transform-origin: center;
		filter: drop-shadow(0 0 0.35rem rgba(255, 205, 99, 0.45));
	}

	@keyframes pop-cheer {
		0%,
		100% {
			transform: translateY(0) scale(1) rotate(0deg);
			opacity: 0.85;
		}
		15% {
			transform: translateY(-4px) scale(1.16) rotate(-12deg);
			opacity: 1;
		}
		35% {
			transform: translateY(0) scale(1.02) rotate(10deg);
		}
		55% {
			transform: translateY(-2px) scale(1.12) rotate(-6deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.celebration {
			animation: none;
		}
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: auto;
	}

	.download-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.6rem 1rem;
		border-radius: 999rem;
		text-decoration: none;
		font-weight: 600;
		color: var(--accent-text-over);
		background: var(--gradient-accent-orange);
		box-shadow: var(--shadow-sm);
	}

	.journal-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.6rem 1rem;
		border-radius: 999rem;
		text-decoration: none;
		font-weight: 600;
		color: var(--gray-100);
		border: 1px solid var(--gray-700);
		background: var(--gray-999_40);
	}

	@media (min-width: 50em) {
		.card {
			border-radius: 1.5rem;
		}

		.copy {
			padding: 1.75rem;
		}
	}
</style>
