---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
const isGerman = Astro.url.pathname === '/de/' || Astro.url.pathname.startsWith('/de/');
const href = isGerman ? `/de/work/${id}` : `/work/${id}`;
---

<a class="card" href={href}>
	<div class="copy">
		<span class="title">{data.title}</span>
		<p>{data.description}</p>
		<div class="tags">
			{data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
		</div>
	</div>
</a>

<style>
	.card {
		display: flex;
		align-items: flex-end;
		min-height: 14rem;
		background:
			linear-gradient(135deg, rgba(15, 135, 122, 0.18), transparent 65%),
			var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition:
			transform var(--theme-transition),
			box-shadow var(--theme-transition),
			border-color var(--theme-transition);
	}

	.card:hover {
		transform: translateY(-0.2rem);
		box-shadow: var(--shadow-md);
		border-color: var(--accent-light);
	}

	.copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
		padding: 1.25rem;
		border-radius: inherit;
		background:
			linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.02)),
			linear-gradient(135deg, var(--accent-soft), transparent 58%),
			var(--gradient-subtle);
	}

	.title {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-100);
	}

	p {
		color: var(--gray-300);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tags span {
		padding: 0.35rem 0.7rem;
		border-radius: 999rem;
		background: var(--gray-999_40);
		border: 1px solid var(--gray-800);
		font-size: var(--text-sm);
		color: var(--gray-200);
	}

	@media (min-width: 50em) {
		.card {
			min-height: 18rem;
			border-radius: 1.5rem;
		}

		.copy {
			padding: 1.75rem;
		}

		.title {
			font-size: var(--text-xl);
		}
	}
</style>
