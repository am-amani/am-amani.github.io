---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portrait comparison" description="Temporary page to compare multiple portrait options.">
	<main class="compare-page">
		<div class="compare-shell">
			<header class="header">
				<p class="eyebrow">Temporary test page</p>
				<h1>Portrait comparison</h1>
				<p class="intro">
				This page is only for reviewing the current portrait options side by side.
				It is not linked from the main website and can be removed later.
			</p>
		</header>

			<div class="cards" aria-label="Portrait comparison gallery">
				<article class="portrait-card selected" data-name="Portrait 4">
					<img src="/assets/Portrait4.png" alt="Portrait option 4" />
					<div class="card-content">
						<h2>Portrait 4</h2>
						<p>Best balance of confidence, framing, and professionalism.</p>
					</div>
				</article>

				<article class="portrait-card" data-name="Portrait 3">
					<img src="/assets/Portrait3.png" alt="Portrait option 3" />
					<div class="card-content">
						<h2>Portrait 3</h2>
						<p>Strong and polished, with a slightly more formal feel.</p>
					</div>
				</article>

				<article class="portrait-card" data-name="Portrait 2">
					<img src="/assets/Portrait2.png" alt="Portrait option 2" />
					<div class="card-content">
						<h2>Portrait 2</h2>
						<p>Good expression and lighting, with a slightly less confident composition.</p>
					</div>
				</article>
			</div>

			<div class="selection-bar" aria-live="polite">
				<strong>Selected:</strong>
				<span id="selection-label">Portrait 4</span>
			</div>

			<div class="note">
				<p>
					Once you pick the preferred version, simply replace the original file at
					<strong>/assets/portrait.jpg</strong> with the chosen image, and this test page can be deleted afterward.
				</p>
			</div>
		</div>
	</main>

	<script>
		const cards = document.querySelectorAll('.portrait-card');
		const label = document.getElementById('selection-label');

		cards.forEach((card) => {
			card.addEventListener('click', () => {
				cards.forEach((item) => item.classList.toggle('selected', item === card));
				label.textContent = card.dataset.name || 'Portrait';
			});
		});
	</script>

	<style>
		:root {
			color-scheme: light;
			--bg: #f4f5f7;
			--panel: #ffffff;
			--panel-soft: #f7f8fa;
			--text: #1c2430;
			--muted: #53657a;
			--accent: #1b7f6a;
			--border: rgba(28, 36, 48, 0.1);
		}

		.compare-page {
			min-height: 100vh;
			display: grid;
			place-items: center;
			padding: 3rem 1.25rem;
			background: linear-gradient(180deg, #f0f2f5 0%, #eef3f6 100%);
			color: var(--text);
		}

		.compare-shell {
			width: min(1200px, 100%);
			padding: 2rem;
			border: 1px solid var(--border);
			border-radius: 24px;
			background: rgba(255, 255, 255, 0.9);
			backdrop-filter: blur(8px);
			box-shadow: 0 20px 40px rgba(28, 36, 48, 0.08);
		}

		.header {
			margin-bottom: 2rem;
		}

		.eyebrow {
			text-transform: uppercase;
			letter-spacing: 0.14em;
			font-size: 0.72rem;
			color: var(--accent);
			font-weight: 700;
			margin: 0 0 0.75rem;
		}

		h1 {
			margin: 0;
			font-size: clamp(2rem, 4vw, 3.25rem);
		}

		.intro {
			margin-top: 0.85rem;
			max-width: 60ch;
			color: var(--muted);
		}

		.cards {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 1.25rem;
		}

		.portrait-card {
			background: var(--panel-soft);
			border: 1px solid var(--border);
			border-radius: 18px;
			overflow: hidden;
			cursor: pointer;
			transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
		}

		.portrait-card:hover {
			transform: translateY(-2px);
			border-color: rgba(120, 208, 181, 0.7);
		}

		.portrait-card.selected {
			border-color: var(--accent);
			box-shadow: 0 0 0 2px rgba(120, 208, 181, 0.22);
		}

		.portrait-card img {
			display: block;
			width: 100%;
			height: 420px;
			object-fit: cover;
			background: #0c1016;
		}

		.card-content {
			padding: 1rem 1rem 1.25rem;
		}

		.card-content h2 {
			margin: 0 0 0.5rem;
			font-size: 1.15rem;
		}

		.card-content p {
			margin: 0;
			color: var(--muted);
			line-height: 1.5;
		}

		.selection-bar {
			margin-top: 1.5rem;
			padding: 1rem 1.1rem;
			border-radius: 12px;
			background: rgba(120, 208, 181, 0.08);
			border: 1px solid rgba(120, 208, 181, 0.25);
			font-size: 1.05rem;
		}

		.note {
			margin-top: 1rem;
			padding-top: 1rem;
			border-top: 1px solid var(--border);
			color: var(--muted);
		}

		.note p {
			margin: 0;
			line-height: 1.65;
		}

		@media (max-width: 700px) {
			.compare-shell {
				padding: 1.25rem;
			}

			.portrait-card img {
				height: 300px;
			}
		}
	</style>
</BaseLayout>
