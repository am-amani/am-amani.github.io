---
import { getCollection } from 'astro:content';
import ContactCTA from '../../components/ContactCTA.astro';
import Grid from '../../components/Grid.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const newsItems = (await getCollection('newsDe')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout title="Neuigkeiten | Amir Mahdi Amani" description="Neueste Meilensteine, Updates und Ankuendigungen.">
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero title="Neuigkeiten" tagline="Meilensteine, Ankuendigungen und Projekt-Updates." align="start" />
			<Grid variant="offset">
				{
					newsItems.map((item) => (
						<li class="news-card">
							<p class="news-meta">
								{item.data.publishDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'short' })} · {item.data.category}
							</p>
							<h3>{item.data.title}</h3>
							<p>{item.data.summary}</p>
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.news-card {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		padding: 1.25rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.2rem;
		background:
			linear-gradient(145deg, rgba(15, 135, 122, 0.14), transparent 64%),
			var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.news-meta {
		font-size: var(--text-sm);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.news-card h3 {
		font-size: var(--text-xl);
		color: var(--gray-100);
	}

	.news-card p {
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		.news-card {
			padding: 1.7rem;
			border-radius: 1.5rem;
		}
	}
</style>
