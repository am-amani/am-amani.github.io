---
import { getCollection } from 'astro:content';
import ContactCTA from '../../components/ContactCTA.astro';
import Grid from '../../components/Grid.astro';
import Hero from '../../components/Hero.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('workDe')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="Projekte | Amir Mahdi Amani"
	description="Ausgewaehlte Projekte in KI, Robotik und Computer Vision von Amir Mahdi Amani."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Projekte"
				tagline="Ausgewaehlte Arbeiten aus Robotik, Computer Vision, 3D-Daten und Deep Learning."
				align="start"
			/>
			<Grid variant="offset">
				{projects.map((project) => <li><PortfolioPreview project={project} /></li>)}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
