---
import { getCollection } from 'astro:content';
import CallToAction from '../../components/CallToAction.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Grid from '../../components/Grid.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import PublicationPreview from '../../components/PublicationPreview.astro';
import Skills from '../../components/Skills.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allProjects = await getCollection('workDe');
const projectBySlug = new Map(allProjects.map((entry) => [entry.id, entry]));
const selectedProjectIds = ['master-thesis-navigation', 'tiago-navigation', 'camera-pose-endoscopy'];
const selectedProjects = selectedProjectIds
	.map((id) => projectBySlug.get(id))
	.filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const featuredPublication = (await getCollection('publicationsDe'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.at(0);

const selectedWork = [featuredPublication, selectedProjects[1], selectedProjects[0], selectedProjects[2]].filter(
	(entry): entry is NonNullable<typeof entry> => Boolean(entry),
);

const highlights = [
	'M.Sc. in KI und Robotik an der Universitaet Padua',
	'AI Solution Engineer mit Fokus auf Netzplanung, Optimierung und Automatisierung',
	'Erst- und korrespondierender Autor einer akzeptierten Journal-Publikation zur Multi-Roboter-Navigation',
	'Erasmus+ Forschungserfahrung an der Universitaet Bonn',
];
---

<BaseLayout
	title="Amir Mahdi Amani | AI Solution Engineer"
	description="Portfolio von Amir Mahdi Amani mit Schwerpunkt auf KI, Robotik, Computer Vision und Automatisierung."
>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Amir Mahdi Amani"
					tagline="AI Solution Engineer in Köln mit Fokus auf Robotik, Computer Vision, Automatisierung und geospatialer Planung."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="terminal-window" size="1.15em" /> KI</Pill>
						<Pill><Icon icon="rocket-launch" size="1.15em" /> Robotik</Pill>
						<Pill><Icon icon="strategy" size="1.15em" /> Automatisierung</Pill>
					</div>
				</Hero>

				<div class="profile-card">
					<div class="profile-photo-wrap">
						<img src="/assets/portrait.jpg" alt="Portraet von Amir Mahdi Amani" />
					</div>
					<p class="eyebrow">Aktuelle Position</p>
					<h2>AI Solution Engineer</h2>
					<p>Deutsche Netzplanung GmbH, Köln</p>
					<div class="profile-links">
						<a href="https://github.com/am-amani">GitHub</a>
						<a href="https://www.linkedin.com/in/amirmahdiamani">LinkedIn</a>
						<a href="mailto:amirmahdi.amani7th@gmail.com">E-Mail</a>
					</div>
					<div class="cv-links">
						<a class="cv-link primary" href="/assets/cv/Amir_Mahdi_Amani_CV_EN.pdf" download>Resume herunterladen (EN PDF)</a>
						<a class="cv-link" href="/assets/cv/Amir_Mahdi_Amani_CV_DE.pdf" download>Lebenslauf herunterladen (DE PDF)</a>
					</div>
				</div>
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Ausgewaehlte Arbeiten</h3>
					<p>Publikation, TIAGO-Navigation, Masterarbeit und Tumor-Detektion.</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							selectedWork.map((entry) => (
								<li>
									{entry.collection === 'publications' || entry.collection === 'publicationsDe' ? (
										<PublicationPreview publication={entry} />
									) : (
										<PortfolioPreview project={entry} />
									)}
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/de/work/">
						Alle Projekte
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Highlights</h3>
					<p>Kurzprofil mit den wichtigsten Punkten.</p>
				</header>

				<div class="gallery">
					<Grid variant="small">
						{highlights.map((highlight) => <li class="mention-card"><p>{highlight}</p></li>)}
					</Grid>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.profile-card {
		width: 100%;
		max-width: 32rem;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		background: linear-gradient(135deg, var(--accent-soft), transparent 58%), var(--gradient-subtle);
		box-shadow: var(--shadow-md);
	}

	.profile-photo-wrap {
		margin-bottom: 1rem;
		border-radius: 1.1rem;
		overflow: hidden;
		border: 1px solid var(--gray-800);
		background: var(--gray-999);
	}

	.profile-photo-wrap img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		height: auto;
		object-fit: cover;
		object-position: center 28%;
	}

	.profile-card h2 {
		font-size: var(--text-2xl);
		margin: 0.35rem 0;
	}

	.eyebrow {
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.profile-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 1rem;
	}

	.profile-links a {
		text-decoration: none;
		color: var(--gray-100);
	}

	.cv-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}

	.cv-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1rem;
		border-radius: 999rem;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid var(--gray-700);
		background: var(--gray-999_40);
		color: var(--gray-100);
		outline: none;
		box-shadow: none;
	}

	.cv-link.primary {
		border-color: var(--accent-regular);
		background: var(--accent-regular);
		color: var(--accent-text-over);
	}

	.cv-link.primary:hover {
		filter: brightness(1.04);
	}

	.cv-link.primary:focus-visible {
		outline: 2px solid var(--accent-light);
		outline-offset: 3px;
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
		}

		.profile-card {
			padding: 2rem;
			align-self: center;
		}
	}

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
			align-self: center;
			justify-self: flex-end;
		}
	}
</style>
