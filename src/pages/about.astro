---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const education = [
	'M.Sc. in Computer Engineering, Artificial Intelligence and Robotics, University of Padova, 2021 to 2024',
	'Erasmus+ exchange for thesis and research internship, University of Bonn, 2023 to 2024',
	'B.Sc. in Computer Software Engineering, University of Birjand, 2015 to 2020',
];

const recognitions = [
	'Accepted 2026 journal paper on multi-robot navigation via LiDAR-to-vision distillation',
	'Erasmus+ Traineeship Scholarship',
	'Regione Veneto Scholarship',
	'Speaker at the 15th International Petroleum Technology Conference, Bangkok, 2023',
];
---

<BaseLayout
	title="About | Amir Mahdi Amani"
	description="Background, education, and focus areas for Amir Mahdi Amani."
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="AI and robotics engineer with a practical focus on intelligent systems, autonomous navigation, and technical automation."
			>
				<div class="intro-card">
					<p>Based in Cologne, Germany</p>
					<p>Currently working at Deutsche Netzplanung GmbH</p>
					<p>Interested in AI, vision, robotics, and automation systems with real operational use.</p>
				</div>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I have an M.Sc. in Artificial Intelligence and Robotics and a background that connects academic research with engineering work. My recent work covers computer vision, autonomous navigation, reinforcement learning, and data-driven planning workflows.
					</p>
					<p>
						My thesis focused on multi-sensor robotic navigation using a teacher-student framework in ROS and Gazebo. In industry, I now contribute to network-planning and automation tasks using geospatial analysis, technical reporting, and software-supported optimization.
					</p>
					<p>
						I enjoy building clear, usable systems that turn technical research into tools that help people make decisions faster and better.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<ul>
						{education.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>
			<section>
				<h2 class="section-title">Recognition</h2>
				<div class="content">
					<ul>
						{recognitions.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	.intro-card {
		margin-top: 1.5rem;
		padding: 1.5rem;
		border-radius: 1.5rem;
		border: 1px solid var(--gray-800);
		background:
			linear-gradient(135deg, var(--accent-soft), transparent 58%),
			var(--gradient-subtle);
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content ul {
		padding-left: 1.2rem;
		display: grid;
		gap: 0.75rem;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
